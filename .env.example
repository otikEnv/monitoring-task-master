# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY - jangan pakai prefix NEXT_PUBLIC_, jangan di-commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kunci enkripsi token repo (AES-256-GCM), 32 byte base64.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Seeder akun awal (npm run seed:users). Isi di .env.local, JANGAN di-commit.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opsional: akun viewer (isi keduanya atau kosongkan keduanya)
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
